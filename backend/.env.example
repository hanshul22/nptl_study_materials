# Copy to backend/.env and fill in. Never commit backend/.env.

# Optional (default 4000). Port the API listens on.
PORT=4000

# Required. MongoDB Atlas connection string. Leave blank here; set it in backend/.env.
MONGODB_URI=

# Optional until AI routes are used (they return AI_NOT_CONFIGURED without it). OpenRouter API key. Never commit a real value.
OPENROUTER_API_KEY=

# Optional until AI routes are used. OpenRouter model id used for answers.
OPENROUTER_MODEL=

# Required. Browser origin allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Optional (default local). Where uploaded PDFs are stored.
STORAGE_DRIVER=local

# Optional (default ./data/pdf). Folder for stored PDFs when STORAGE_DRIVER=local.
STORAGE_LOCAL_DIR=./data/pdf

# Optional (default ./data/tmp). Temp folder for uploads while they are processed.
TMP_DIR=./data/tmp

# Optional (default 25). Maximum PDF upload size in MB.
MAX_PDF_MB=25

# Optional (default 300). Maximum pages per PDF.
MAX_PDF_PAGES=300

# Optional (default 20). AI requests allowed per minute per IP.
AI_RATE_LIMIT_PER_MIN=20
